# Durable persistence (optional) — Upstash Redis REST credentials.
#
# Without these two vars the app behaves exactly as before: local SQLite only, and async
# games survive only while the instance stays warm. With them set, every active room and its
# seats are mirrored to Upstash and rehydrated on boot, so games survive a cold start, redeploy,
# or platform restart. KV is written in the background and read only once at startup, so it can
# never slow or break the live game.
#
# Setup: create a free database at https://upstash.com, open it, and copy the "REST API" URL +
# token into the two values below (and into Render's Environment tab for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional keep-alive / deploy tuning (see README "Deploying to Render"):
# PUBLIC_URL=
# KEEPALIVE_INTERVAL_MS=600000
